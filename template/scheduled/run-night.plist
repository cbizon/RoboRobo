<?xml version="1.0" encoding="UTF-8"?>
<!-- Rendered from RoboRobo's template by `program sync`; don't edit here.
     Starts `program run-night` for {{name}} at {{session_start}} each day.
     Install: see scheduled/README.md.
     launchd's login shell doesn't read ~/.zshrc, where installers usually
     put ~/.local/bin (Claude Code's own location) on PATH; so it's added here. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.renci.roborobo.{{name}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>export PATH="$HOME/.local/bin:$PATH" &amp;&amp; mkdir -p {{data_dir}}/logs &amp;&amp; caffeinate -i uv run --project {{roborobo}} program run-night --repo {{repo}} &gt;&gt; {{data_dir}}/logs/run-night.log 2&gt;&amp;1</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>{{session_start_hour}}</integer>
    <key>Minute</key>
    <integer>{{session_start_minute}}</integer>
  </dict>
</dict>
</plist>
