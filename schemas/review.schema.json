{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renci.org/research-programs/schemas/review.schema.json",
  "title": "Checker review (reviews/YYYY-MM-DD.json)",
  "type": "object",
  "required": [
    "date",
    "reviewer_model",
    "summary",
    "reviews"
  ],
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "reviewer_model": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "$ref": "_common.schema.json#/$defs/text"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "plain_claim",
          "verdict",
          "attacks"
        ],
        "properties": {
          "claim_id": {
            "$ref": "_common.schema.json#/$defs/id"
          },
          "plain_claim": {
            "$ref": "_common.schema.json#/$defs/text"
          },
          "verdict": {
            "enum": [
              "holds",
              "doubtful",
              "broken"
            ]
          },
          "attacks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "check",
                "what_was_done",
                "finding"
              ],
              "properties": {
                "check": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A failure mode from DIRECTION.md, or 'other'"
                },
                "what_was_done": {
                  "$ref": "_common.schema.json#/$defs/text"
                },
                "finding": {
                  "$ref": "_common.schema.json#/$defs/text"
                }
              },
              "additionalProperties": false
            }
          },
          "what_would_resolve": {
            "$ref": "_common.schema.json#/$defs/text"
          }
        },
        "if": {
          "properties": {
            "verdict": {
              "enum": [
                "doubtful",
                "broken"
              ]
            }
          }
        },
        "then": {
          "required": [
            "what_would_resolve"
          ]
        },
        "additionalProperties": false
      }
    },
    "answers": {
      "type": "array",
      "description": "Whether the session answered each item under 'Asked' in the instruction, as it was worded.",
      "items": {
        "type": "object",
        "required": [
          "asked",
          "verdict",
          "finding"
        ],
        "properties": {
          "asked": {
            "$ref": "_common.schema.json#/$defs/text"
          },
          "verdict": {
            "enum": [
              "answered",
              "partly",
              "not_answered",
              "different_question"
            ]
          },
          "finding": {
            "$ref": "_common.schema.json#/$defs/text"
          }
        },
        "additionalProperties": false
      }
    },
    "run_conditions": {
      "type": "object",
      "description": "The checker's assessment of how the session's environment worked, when the program records run conditions.",
      "required": [
        "verdict",
        "assessment"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "adequate",
            "strained",
            "inadequate"
          ]
        },
        "assessment": {
          "$ref": "_common.schema.json#/$defs/text"
        },
        "discrepancies": {
          "type": "array",
          "items": {
            "$ref": "_common.schema.json#/$defs/text"
          },
          "description": "Where recorded conditions disagree with what the machine shows"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
